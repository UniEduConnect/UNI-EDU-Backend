{
  "family": "uni-edu-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::164733187525:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::164733187525:role/uni-edu-task-role",
  "containerDefinitions": [
    {
      "name": "uni-edu-api",
      "image": "164733187525.dkr.ecr.ap-southeast-1.amazonaws.com/uni-edu-api:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
        { "name": "ASPNETCORE_URLS", "value": "http://+:8080" },
        { "name": "ENABLE_SWAGGER", "value": "true" },
        { "name": "AUTO_MIGRATE", "value": "true" },
        { "name": "POSTGRES_SSLMODE", "value": "Require" },
        { "name": "Logging__LogLevel__Default", "value": "Information" },
        {
          "name": "Logging__LogLevel__Microsoft.AspNetCore",
          "value": "Warning"
        },
        { "name": "Smtp__Host", "value": "smtp.gmail.com" },
        { "name": "Smtp__Port", "value": "587" },
        { "name": "Smtp__UseStartTls", "value": "true" },
        { "name": "Smtp__FromName", "value": "UNI EDU" },
        { "name": "Smtp__FromEmail", "value": "tranngochan29052004@gmail.com" },
        { "name": "Smtp__User", "value": "tranngochan29052004@gmail.com" },
        { "name": "Ai__BaseUrl", "value": "https://openrouter.ai/api/v1" },
        { "name": "Ai__OpenAiModel", "value": "deepseek/deepseek-chat" },
        { "name": "S3__BucketName", "value": "uni-bucket-name" },
        { "name": "S3__Region", "value": "ap-southeast-1" },
        {
          "name": "VnPay__PayUrl",
          "value": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
        },
        {
          "name": "VnPay__ReturnUrl",
          "value": "https://unieducation.net/wallet/deposit-return"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_DB",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_DB"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_USER"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_PASSWORD"
        },
        {
          "name": "POSTGRES_HOST",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_HOST"
        },
        {
          "name": "POSTGRES_PORT",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_PORT"
        },
        {
          "name": "JWT_SecretKey",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/JWT_SecretKey"
        },
        {
          "name": "Smtp__Password",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/Smtp__Password"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/OPENAI_API_KEY"
        },
        {
          "name": "VnPay__TmnCode",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/VnPay__TmnCode"
        },
        {
          "name": "VnPay__HashSecret",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/VnPay__HashSecret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uni-edu-api",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
}
