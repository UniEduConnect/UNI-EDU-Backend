{
  "family": "uni-edu-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::164733187525:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "uni-edu-api",
      "image": "164733187525.dkr.ecr.ap-southeast-1.amazonaws.com/uni-edu-api:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
        { "name": "ASPNETCORE_URLS", "value": "http://+:8080" },
        { "name": "ENABLE_SWAGGER", "value": "true" },
        { "name": "AUTO_MIGRATE", "value": "true" },
        { "name": "POSTGRES_SSLMODE", "value": "Require" },
        { "name": "Logging__LogLevel__Default", "value": "Information" },
        { "name": "Logging__LogLevel__Microsoft.AspNetCore", "value": "Warning" }
      ],
      "secrets": [
        { "name": "POSTGRES_DB", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_DB" },
        { "name": "POSTGRES_USER", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_USER" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_PASSWORD" },
        { "name": "POSTGRES_HOST", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_HOST" },
        { "name": "POSTGRES_PORT", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/POSTGRES_PORT" },
        { "name": "JWT_SecretKey", "valueFrom": "arn:aws:ssm:ap-southeast-1:164733187525:parameter/uni-edu/JWT_SecretKey" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uni-edu-api",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
}
